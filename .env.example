# Public control-plane URL only. Never put credentials in WXT_ variables.
WXT_PREVIEW_API_BASE_URL=http://127.0.0.1:8787

# Server-only examples. Keep real values in .env.local or deployment secrets.
PEEPHOLE_API_HOST=127.0.0.1
PEEPHOLE_API_PORT=8787
PEEPHOLE_DATABASE_URL=postgres://peephole:replace-me@localhost:5432/peephole
PEEPHOLE_DATABASE_POOL_SIZE=10

# Optional: raises services/local-preview/devServer.ts's own server-side
# GitHub API calls (repository/plan resolution) from 60/hour
# (unauthenticated) to 5,000/hour. No scopes needed for public repositories.
# This is the server's own token, unrelated to end users: each preview
# *request* is authenticated separately, against the caller's own GitHub
# token set from the extension's options page (see
# services/preview-api/githubRequesterAuth.ts) -- never from this file.
# PEEPHOLE_GITHUB_TOKEN=ghp_replace-me

# Optional in development: signs the short-lived Peephole session tokens
# issued by POST /v1/auth/session (see services/preview-api/previewSession.ts).
# Must be at least 32 bytes. If unset, devServer.ts generates a random one
# on every start -- fine for local development (a restart just signs
# everyone out silently), but a real deployment should set this so a
# restart doesn't invalidate every active session.
# PEEPHOLE_SESSION_SIGNING_SECRET=replace-with-a-random-32-plus-byte-string
